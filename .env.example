# Local development is bound to loopback. Never commit real credentials.
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
SEED_SAMPLE=true

# Local sample accounts use ClaimChainDemo!2026. Set a unique bootstrap
# password for an empty production workspace.
# AUTH_BOOTSTRAP_USERNAME=admin
# AUTH_BOOTSTRAP_EMAIL=admin@example.com
# AUTH_BOOTSTRAP_PASSWORD=
AUTH_COOKIE_NAME=claimchain_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=12
AUTH_CODE_TTL_MINUTES=10
# Development only: includes email codes in API responses for local UI testing.
AUTH_EXPOSE_CODES=true
# APP_ORIGIN=https://claims.example.com

# Synthetic ingestion keeps the sample workspace moving without an external feed.
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=30000

# SMTP is optional locally; without it, delivery is logged in console mode.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=ClaimChain <noreply@example.com>

AWS_REGION=ap-south-1
# Configure only resources your account can access.
# S3_BUCKET=
# ENABLE_TEXTRACT=true
# BEDROCK_MODEL_ID=
# Prefer an attached IAM role or AWS_PROFILE to long-lived access keys.
