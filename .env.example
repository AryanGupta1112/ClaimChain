# Local development is bound to loopback. Never commit real credentials.
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
SEED_SAMPLE=true

# Required before binding to a public interface. Use strong random values.
# ACCESS_PASSWORD=
# SESSION_SECRET=
# COOKIE_SECURE=true
# APP_ORIGIN=https://claims.example.com

AWS_REGION=ap-south-1
# Configure only resources your account can access.
# S3_BUCKET=
# ENABLE_TEXTRACT=true
# BEDROCK_MODEL_ID=
# Prefer an attached IAM role or AWS_PROFILE to long-lived access keys.
